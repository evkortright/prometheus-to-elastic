# Copy this file to .env.elastic in the repo root and fill in the values.
# .env.elastic is gitignored. Never commit it.

# Base Elasticsearch endpoint: no path (a port is optional; the script strips :443).
ES_ENDPOINT=https://<project-id>.es.<region>.<cloud>.elastic.cloud

# The "encoded" value returned when you create the API key.
ES_API_KEY=<your-encoded-api-key>
